# -*- coding: utf-8 -*-
"""Финальный аудит чистоты статей «Исследования» (research + exposures).

1. Все JSON валидны.
2. Нет квадратного письма (U+0590–U+05FF, U+FB1D–U+FB4F).
3. Нет религионизмов и греко-славянских калек из словаря проекта.
4. Нет греко-славянских названий книг в ссылках на стихи (только палео).
"""
import glob
import io
import json
import re

FILES = (
    glob.glob("products/website/apps/researchlab/data/research/*.json")
    + glob.glob("products/website/apps/researchlab/data/exposures/*.json")
)

SQUARE = re.compile(r"[\u0590-\u05FF\uFB1D-\uFB4F]")

# Религионизмы и NT-книги (словарь проекта)
RELIG = [
    "Бог", "Господь", "душа", "дух", "грех", "жертва", "завет",
    "закон", "церковь", "священник", "пророк", "ангел", "апостол",
    "Христос", "Иисус", "крест", "Библия", "логос", "святой",
    "святость", "Творец", "покаяние", "Септуагинта", "Синодальный",
    "Ветхий Завет", "Новый Завет", "Священное Писание",
    # NT-книги
    "Матфей", "Марк", "Луки", "Лука", "Йоханан", "Йоханнан", "ЙОХАНАН",
    "Иоанна", "Римлянам", "Галатам", "Галатим", "ГАЛАТИМ", "Ефесянам",
    "Филиппийцам", "Колоссянам", "Фессалоникийцам", "Тимофею",
    "Титу", "Филимону", "Евреям", "Иакова", "Яаков", "Яакова",
    "Кефы", "Петра", "Иуды", "Деяния", "Откровение", "Апокалипсис",
    "Евангелие", "Хитают", "Маттитьяhу", "Матитьягу", "Маккавейская",
    "Шаббат", "Мишна", "Мишны", "Хроники",
]
RELIG_RE = re.compile(r"\b(" + "|".join(RELIG) + r")\b", re.IGNORECASE)

# Греко-славянские названия книг (запрещены в ссылках на стихи)
GRECO_BOOKS = [
    "Бытие", "Исход", "Левит", "Числа", "Второзаконие",
    "Иисус Навин", "Судей", "Исаия", "Исайя", "Иеремия",
    "Иезекииль", "Даниил", "Осия", "Иоиль", "Авдий",
    "Михей", "Наум", "Аввакум", "Софония", "Аггей",
    "Захария", "Малахия", "Псалтирь", "Псалом", "Псалмы",
    "Притчи", "Екклесиаст", "Екклезиаст", "Песнь", "Плач",
    "Есфирь", "Иов", "Самуил", "Царств",
    "Паралипоменон", "Неемия", "Хроники",
]
# Только в составе ссылки: название + номер
GRECO_REF_RE = re.compile(
    r"(?<![А-Яа-яЁё0-9])(" + "|".join(re.escape(b) for b in GRECO_BOOKS) + r")\s*\d+\s*:\s*\d+"
)

errors = []
for path in FILES:
    raw = io.open(path, encoding="utf-8").read()
    try:
        data = json.loads(raw)
    except Exception as exc:
        errors.append("INVALID JSON %s: %s" % (path, exc))
        continue

    for lineno, line in enumerate(raw.splitlines(), 1):
        if SQUARE.search(line):
            errors.append("SQUARE %s:%d %s" % (path, lineno, line.strip()[:100]))

    def walk(node):
        if isinstance(node, dict):
            for value in node.values():
                if isinstance(value, str):
                    for m in RELIG_RE.finditer(value):
                        errors.append("TERM %s %r in %r" % (path, m.group(0), value[:80]))
                    for m in GRECO_REF_RE.finditer(value):
                        errors.append("GRECO-REF %s %r in %r" % (path, m.group(1), value[max(0, m.start() - 15):m.end() + 15]))
                elif isinstance(value, (dict, list)):
                    walk(value)
        elif isinstance(node, list):
            for item in node:
                walk(item)

    walk(data)

if errors:
    print("\n".join(errors))
    raise SystemExit(1)
print("CLEAN: %d files, no square script, no religionisms, no greco book refs." % len(FILES))